<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="three_r_robot">

  <!-- ===================================================== -->
  <!-- PARAMETERS                                            -->
  <!-- ===================================================== -->

  <!-- All dimensions are in metres for ROS/Gazebo -->

  <xacro:property name="L1" value="0.05"/>
  <xacro:property name="L2" value="0.11"/>
  <xacro:property name="L3" value="0.11"/>

  <xacro:property name="base_radius" value="0.045"/>

  <xacro:property name="link_width" value="0.025"/>
  <xacro:property name="link_height" value="0.025"/>


  <!-- ===================================================== -->
  <!-- MATERIALS                                             -->
  <!-- ===================================================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>


  <!-- ===================================================== -->
  <!-- WORLD                                                 -->
  <!-- ===================================================== -->

  <link name="world"/>


  <!-- ===================================================== -->
  <!-- JOINT 1 - BASE YAW                                   -->
  <!-- ===================================================== -->

  <joint name="joint1"
         type="revolute">

    <parent link="world"/>
    <child link="base_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="0.0"
      upper="3.14159265"
      effort="20"
      velocity="2.0"/>

    <dynamics
      damping="0.2"
      friction="0.05"/>

  </joint>


  <!-- ===================================================== -->
  <!-- BASE                                                 -->
  <!-- ===================================================== -->

  <link name="base_link">

    <visual>

      <origin
        xyz="0 0 ${L1/2}"
        rpy="0 0 0"/>

      <geometry>

        <cylinder
          radius="${base_radius}"
          length="${L1}"/>

      </geometry>

      <material name="blue"/>

    </visual>


    <collision>

      <origin
        xyz="0 0 ${L1/2}"
        rpy="0 0 0"/>

      <geometry>

        <cylinder
          radius="${base_radius}"
          length="${L1}"/>

      </geometry>

    </collision>


    <inertial>

      <origin
        xyz="0 0 ${L1/2}"
        rpy="0 0 0"/>

      <mass value="0.5"/>

      <inertia
        ixx="0.0002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0002"
        iyz="0.0"
        izz="0.0002"/>

    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- JOINT 2 - SHOULDER                                   -->
  <!-- ===================================================== -->

  <joint name="joint2"
         type="revolute">

    <parent link="base_link"/>
    <child link="link1"/>

    <origin
      xyz="0 0 ${L1}"
      rpy="0 0 0"/>

    <!-- Negative Y gives the same direction as your FK -->

    <axis xyz="0 -1 0"/>

    <limit
      lower="0.0"
      upper="3.14159265"
      effort="20"
      velocity="2.0"/>

    <dynamics
      damping="0.2"
      friction="0.05"/>

  </joint>


  <!-- ===================================================== -->
  <!-- LINK 1                                               -->
  <!-- ===================================================== -->

  <link name="link1">

    <visual>

      <origin
        xyz="${L2/2} 0 0"
        rpy="0 0 0"/>

      <geometry>

        <box
          size="${L2} ${link_width} ${link_height}"/>

      </geometry>

      <material name="blue"/>

    </visual>


    <collision>

      <origin
        xyz="${L2/2} 0 0"
        rpy="0 0 0"/>

      <geometry>

        <box
          size="${L2} ${link_width} ${link_height}"/>

      </geometry>

    </collision>


    <inertial>

      <origin
        xyz="${L2/2} 0 0"
        rpy="0 0 0"/>

      <mass value="0.30"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>

    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- JOINT 3 - ELBOW                                     -->
  <!-- ===================================================== -->

  <joint name="joint3"
         type="revolute">

    <parent link="link1"/>
    <child link="link2"/>

    <origin
      xyz="${L2} 0 0"
      rpy="0 0 0"/>

    <!-- Negative Y -->

    <axis xyz="0 -1 0"/>

    <!-- DH theta3 = -90 to +90 -->

    <limit
      lower="-1.57079633"
      upper="1.57079633"
      effort="20"
      velocity="2.0"/>

    <dynamics
      damping="0.2"
      friction="0.05"/>

  </joint>


  <!-- ===================================================== -->
  <!-- LINK 2                                               -->
  <!-- ===================================================== -->

  <link name="link2">

    <visual>

      <origin
        xyz="${L3/2} 0 0"
        rpy="0 0 0"/>

      <geometry>

        <box
          size="${L3} ${link_width} ${link_height}"/>

      </geometry>

      <material name="grey"/>

    </visual>


    <collision>

      <origin
        xyz="${L3/2} 0 0"
        rpy="0 0 0"/>

      <geometry>

        <box
          size="${L3} ${link_width} ${link_height}"/>

      </geometry>

    </collision>


    <inertial>

      <origin
        xyz="${L3/2} 0 0"
        rpy="0 0 0"/>

      <mass value="0.25"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>

    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- END EFFECTOR JOINT                                   -->
  <!-- ===================================================== -->

  <joint name="end_effector_joint"
         type="fixed">

    <parent link="link2"/>
    <child link="end_effector"/>

    <origin
      xyz="${L3} 0 0"
      rpy="0 0 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- END EFFECTOR                                         -->
  <!-- ===================================================== -->

  <link name="end_effector">

    <visual>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>

        <sphere
          radius="0.015"/>

      </geometry>

      <material name="red"/>

    </visual>


    <collision>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>

        <sphere
          radius="0.015"/>

      </geometry>

    </collision>


    <inertial>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="0.05"/>

      <inertia
        ixx="0.00001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00001"
        iyz="0.0"
        izz="0.00001"/>

    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- ROS 2 CONTROL                                        -->
  <!-- ===================================================== -->

  <ros2_control
      name="GazeboSystem"
      type="system">

    <hardware>

      <plugin>
        gz_ros2_control/GazeboSimSystem
      </plugin>

    </hardware>


    <!-- JOINT 1 -->

    <joint name="joint1">

      <command_interface name="position"/>

      <state_interface name="position"/>

    </joint>


    <!-- JOINT 2 -->

    <joint name="joint2">

      <command_interface name="position"/>

      <state_interface name="position"/>

    </joint>


    <!-- JOINT 3 -->

    <joint name="joint3">

      <command_interface name="position"/>

      <state_interface name="position"/>

    </joint>

  </ros2_control>


  <!-- ===================================================== -->
  <!-- GAZEBO / GZ ROS 2 CONTROL                           -->
  <!-- ===================================================== -->

  <gazebo>

    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>
        /home/astram/ros2_3r_ws/src/three_r_robot/config/controllers.yaml
      </parameters>

    </plugin>

  </gazebo>


</robot>